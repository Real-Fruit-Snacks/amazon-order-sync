{
  "manifest_version": 3,
  "name": "Amazon Order Sync",
  "version": "1.0.4",
  "description": "Sync Amazon orders to local Obsidian vault.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.amazon.com/*",
    "http://127.0.0.1:27483/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/your-orders/*",
        "*://*.amazon.com/gp/css/order-history*",
        "*://*.amazon.com/review/create-review*",
        "*://*.amazon.com/review/review-your-purchases*"
      ],
      "js": ["content.js"]
    }
  ]
}
