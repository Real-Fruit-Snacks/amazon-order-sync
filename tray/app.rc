// Windows resources for AmazonOrderSync.exe: the icon, the manifest and the
// version shown in Explorer. build.rs compiles this (rc.exe or windres).
#include <winver.h>

1 ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION AOS_VERSION_COMMAS
PRODUCTVERSION AOS_VERSION_COMMAS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RFS"
            VALUE "FileDescription", "Amazon Order Sync"
            VALUE "FileVersion", AOS_VERSION_STR
            VALUE "InternalName", "AmazonOrderSync"
            VALUE "LegalCopyright", "Copyright (c) 2026 Real-Fruit-Snacks. MIT License."
            VALUE "OriginalFilename", "AmazonOrderSync.exe"
            VALUE "ProductName", "Amazon Order Sync"
            VALUE "ProductVersion", AOS_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
